{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run both extensions",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/changed-files-explorer",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/ftp-sftp-deploy"
      ],
      "outFiles": ["${workspaceFolder}/packages/*/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run PHP Forge",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/php-forge"],
      "outFiles": ["${workspaceFolder}/packages/php-forge/dist/**/*.cjs"],
      "preLaunchTask": "npm: build"
    }
  ]
}
