{
  "name": "vscode-extensions",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspace ftp-sftp-deploy && node test/l10n.test.js",
    "test:e2e": "npm run build && node test/e2e/run.js",
    "package": "npm run package --workspaces",
    "icons": "node scripts/icons.js",
    "ovsx:namespace": "ovsx create-namespace yuval-abdm",
    "publish:ovsx": "ovsx publish packages/ftp-sftp-deploy/ftp-sftp-deploy-$npm_package_config_version.vsix && ovsx publish packages/changed-files-explorer/changed-files-explorer-$npm_package_config_version.vsix"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ftp-srv": "^4.6.3",
    "ovsx": "^1.2.0"
  },
  "config": {
    "version": "1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuval-Abdm/vscode-extensions.git"
  }
}
