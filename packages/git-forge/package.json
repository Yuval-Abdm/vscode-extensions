{
  "name": "git-forge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "yuval-abdm",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2b24",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuval-Abdm/vscode-extensions.git",
    "directory": "packages/git-forge"
  },
  "bugs": {
    "url": "https://github.com/Yuval-Abdm/vscode-extensions/issues"
  },
  "homepage": "https://github.com/Yuval-Abdm/vscode-extensions/tree/main/packages/git-forge#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "l10n": "./l10n",
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "history",
    "annotations",
    "graph",
    "merge",
    "conflicts",
    "rebase",
    "gitlens alternative"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "bench": "node scripts/bench.ts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.91.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "configuration": {
      "title": "Git Spark",
      "properties": {
        "gitForge.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.blame.enabled%"
        },
        "gitForge.blame.format": {
          "type": "string",
          "default": "${author}, ${date} • ${message}",
          "markdownDescription": "%config.blame.format%"
        },
        "gitForge.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.blame.statusBar%"
        },
        "gitForge.blame.maxLines": {
          "type": "number",
          "default": 20000,
          "minimum": 1,
          "description": "%config.blame.maxLines%"
        },
        "gitForge.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.enabled%"
        },
        "gitForge.conflicts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.conflicts.enabled%"
        },
        "gitForge.merge.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.merge.enabled%"
        },
        "gitForge.compare.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.compare.enabled%"
        },
        "gitForge.graph.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.graph.enabled%"
        },
        "gitForge.operations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.operations.enabled%"
        },
        "gitForge.rebaseEditor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.rebaseEditor%"
        },
        "gitForge.commit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.commit.enabled%"
        },
        "gitForge.commit.pullBeforeCommit": {
          "type": "boolean",
          "default": true,
          "description": "%config.commit.pullBeforeCommit%"
        }
      }
    },
    "commands": [
      {
        "command": "gitForge.toggleFileBlame",
        "title": "%command.toggleFileBlame%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.showLineCommit",
        "title": "%command.showLineCommit%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.diffWithPrevious",
        "title": "%command.diffWithPrevious%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.openRevision",
        "title": "%command.openRevision%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.copySha",
        "title": "%command.copySha%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.showFileHistory",
        "title": "%command.showFileHistory%",
        "category": "Git Spark",
        "icon": "$(history)"
      },
      {
        "command": "gitForge.showLineHistory",
        "title": "%command.showLineHistory%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.history.pin",
        "title": "%command.history.pin%",
        "category": "Git Spark",
        "icon": "$(pin)"
      },
      {
        "command": "gitForge.history.unpin",
        "title": "%command.history.unpin%",
        "category": "Git Spark",
        "icon": "$(pinned)"
      },
      {
        "command": "gitForge.history.refresh",
        "title": "%command.history.refresh%",
        "category": "Git Spark",
        "icon": "$(refresh)"
      },
      {
        "command": "gitForge.history.openRevision",
        "title": "%command.openRevision%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.history.compareWithWorking",
        "title": "%command.history.compareWithWorking%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.history.copySha",
        "title": "%command.copySha%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.history.copyMessage",
        "title": "%command.history.copyMessage%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.mergeLocal",
        "title": "%command.mergeLocal%",
        "category": "Git Spark",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitForge.conflicts.refresh",
        "title": "%command.history.refresh%",
        "category": "Git Spark",
        "icon": "$(refresh)"
      },
      {
        "command": "gitForge.conflicts.finish",
        "title": "%command.conflicts.finish%",
        "category": "Git Spark",
        "icon": "$(check-all)"
      },
      {
        "command": "gitForge.conflicts.abort",
        "title": "%command.conflicts.abort%",
        "category": "Git Spark",
        "icon": "$(discard)"
      },
      {
        "command": "gitForge.conflicts.keepOurs",
        "title": "%command.conflicts.keepOurs%",
        "category": "Git Spark",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitForge.conflicts.keepTheirs",
        "title": "%command.conflicts.keepTheirs%",
        "category": "Git Spark",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitForge.conflicts.keepBoth",
        "title": "%command.conflicts.keepBoth%",
        "category": "Git Spark",
        "icon": "$(arrow-both)"
      },
      {
        "command": "gitForge.conflicts.keepAllOurs",
        "title": "%command.conflicts.keepAllOurs%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.conflicts.keepAllTheirs",
        "title": "%command.conflicts.keepAllTheirs%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.conflicts.openMergeEditor",
        "title": "%command.conflicts.openMergeEditor%",
        "category": "Git Spark",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitForge.conflicts.markResolved",
        "title": "%command.conflicts.markResolved%",
        "category": "Git Spark",
        "icon": "$(check)"
      },
      {
        "command": "gitForge.conflicts.keepFile",
        "title": "%command.conflicts.keepFile%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.conflicts.deleteFile",
        "title": "%command.conflicts.deleteFile%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.compareReferences",
        "title": "%command.compareReferences%",
        "category": "Git Spark",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitForge.compare.swap",
        "title": "%command.compare.swap%",
        "category": "Git Spark",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitForge.compare.toggleMode",
        "title": "%command.compare.toggleMode%",
        "category": "Git Spark",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "gitForge.compare.clear",
        "title": "%command.compare.clear%",
        "category": "Git Spark",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitForge.compare.deploy",
        "title": "%command.compare.deploy%",
        "category": "Git Spark",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitForge.compare.show",
        "title": "%command.compareReferences%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.stash.push",
        "title": "%command.stash.push%",
        "category": "Git Spark",
        "icon": "$(add)"
      },
      {
        "command": "gitForge.stash.apply",
        "title": "%command.stash.apply%",
        "category": "Git Spark",
        "icon": "$(check)"
      },
      {
        "command": "gitForge.stash.pop",
        "title": "%command.stash.pop%",
        "category": "Git Spark",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitForge.stash.drop",
        "title": "%command.stash.drop%",
        "category": "Git Spark",
        "icon": "$(trash)"
      },
      {
        "command": "gitForge.worktree.add",
        "title": "%command.worktree.add%",
        "category": "Git Spark",
        "icon": "$(add)"
      },
      {
        "command": "gitForge.worktree.open",
        "title": "%command.worktree.open%",
        "category": "Git Spark",
        "icon": "$(empty-window)"
      },
      {
        "command": "gitForge.worktree.remove",
        "title": "%command.worktree.remove%",
        "category": "Git Spark",
        "icon": "$(trash)"
      },
      {
        "command": "gitForge.showGraph",
        "title": "%command.showGraph%",
        "category": "Git Spark",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitForge.graph.checkoutCommit",
        "title": "%command.graph.checkoutCommit%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.createBranch",
        "title": "%command.graph.createBranch%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.createTag",
        "title": "%command.graph.createTag%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.compareWithHead",
        "title": "%command.graph.compareWithHead%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.copySha",
        "title": "%command.copySha%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.checkoutBranch",
        "title": "%command.graph.checkoutBranch%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.mergeBranch",
        "title": "%command.graph.mergeBranch%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.deleteBranch",
        "title": "%command.graph.deleteBranch%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graph.compareWithSelected",
        "title": "%command.graph.compareWithSelected%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.cherryPick",
        "title": "%command.cherryPick%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.revert",
        "title": "%command.revert%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.reset",
        "title": "%command.reset%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.interactiveRebase",
        "title": "%command.interactiveRebase%",
        "category": "Git Spark"
      },
      {
        "command": "gitForge.graphView.refresh",
        "title": "%command.history.refresh%",
        "category": "Git Spark",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitForge.toggleFileBlame",
          "when": "gitForge.active && config.gitForge.blame.enabled"
        },
        {
          "command": "gitForge.showLineCommit",
          "when": "gitForge.active && config.gitForge.blame.enabled"
        },
        {
          "command": "gitForge.diffWithPrevious",
          "when": "false"
        },
        {
          "command": "gitForge.openRevision",
          "when": "false"
        },
        {
          "command": "gitForge.copySha",
          "when": "false"
        },
        {
          "command": "gitForge.showFileHistory",
          "when": "gitForge.active && config.gitForge.history.enabled",
          "visibility": "collapsed"
        },
        {
          "command": "gitForge.showLineHistory",
          "when": "gitForge.active && config.gitForge.history.enabled && editorIsOpen"
        },
        {
          "command": "gitForge.history.pin",
          "when": "false"
        },
        {
          "command": "gitForge.history.unpin",
          "when": "false"
        },
        {
          "command": "gitForge.history.refresh",
          "when": "false"
        },
        {
          "command": "gitForge.history.openRevision",
          "when": "false"
        },
        {
          "command": "gitForge.history.compareWithWorking",
          "when": "false"
        },
        {
          "command": "gitForge.history.copySha",
          "when": "false"
        },
        {
          "command": "gitForge.history.copyMessage",
          "when": "false"
        },
        {
          "command": "gitForge.mergeLocal",
          "when": "gitForge.active && config.gitForge.merge.enabled"
        },
        {
          "command": "gitForge.conflicts.finish",
          "when": "gitForge.conflicts.active && config.gitForge.conflicts.enabled"
        },
        {
          "command": "gitForge.conflicts.abort",
          "when": "gitForge.conflicts.active && config.gitForge.conflicts.enabled"
        },
        {
          "command": "gitForge.conflicts.refresh",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepOurs",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepTheirs",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepBoth",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepAllOurs",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepAllTheirs",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.openMergeEditor",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.markResolved",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.keepFile",
          "when": "false"
        },
        {
          "command": "gitForge.conflicts.deleteFile",
          "when": "false"
        },
        {
          "command": "gitForge.compareReferences",
          "when": "gitForge.active && config.gitForge.compare.enabled"
        },
        {
          "command": "gitForge.stash.push",
          "when": "gitForge.active && config.gitForge.compare.enabled"
        },
        {
          "command": "gitForge.worktree.add",
          "when": "gitForge.active && config.gitForge.compare.enabled"
        },
        {
          "command": "gitForge.compare.swap",
          "when": "false"
        },
        {
          "command": "gitForge.compare.toggleMode",
          "when": "false"
        },
        {
          "command": "gitForge.compare.clear",
          "when": "false"
        },
        {
          "command": "gitForge.compare.deploy",
          "when": "false"
        },
        {
          "command": "gitForge.compare.show",
          "when": "false"
        },
        {
          "command": "gitForge.stash.apply",
          "when": "false"
        },
        {
          "command": "gitForge.stash.pop",
          "when": "false"
        },
        {
          "command": "gitForge.stash.drop",
          "when": "false"
        },
        {
          "command": "gitForge.worktree.open",
          "when": "false"
        },
        {
          "command": "gitForge.worktree.remove",
          "when": "false"
        },
        {
          "command": "gitForge.showGraph",
          "when": "gitForge.active && config.gitForge.graph.enabled"
        },
        {
          "command": "gitForge.graph.checkoutCommit",
          "when": "false"
        },
        {
          "command": "gitForge.graph.createBranch",
          "when": "false"
        },
        {
          "command": "gitForge.graph.createTag",
          "when": "false"
        },
        {
          "command": "gitForge.graph.compareWithHead",
          "when": "false"
        },
        {
          "command": "gitForge.graph.copySha",
          "when": "false"
        },
        {
          "command": "gitForge.graph.checkoutBranch",
          "when": "false"
        },
        {
          "command": "gitForge.graph.mergeBranch",
          "when": "false"
        },
        {
          "command": "gitForge.graph.deleteBranch",
          "when": "false"
        },
        {
          "command": "gitForge.graph.compareWithSelected",
          "when": "false"
        },
        {
          "command": "gitForge.cherryPick",
          "when": "false"
        },
        {
          "command": "gitForge.revert",
          "when": "false"
        },
        {
          "command": "gitForge.reset",
          "when": "false"
        },
        {
          "command": "gitForge.interactiveRebase",
          "when": "false"
        },
        {
          "command": "gitForge.graphView.refresh",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitForge.history.pin",
          "when": "view == gitForge.history && !gitForge.history.pinned",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.history.unpin",
          "when": "view == gitForge.history && gitForge.history.pinned",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.history.refresh",
          "when": "view == gitForge.history",
          "group": "navigation@2"
        },
        {
          "command": "gitForge.conflicts.finish",
          "when": "view == gitForge.conflicts",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.conflicts.abort",
          "when": "view == gitForge.conflicts",
          "group": "navigation@2"
        },
        {
          "command": "gitForge.conflicts.refresh",
          "when": "view == gitForge.conflicts",
          "group": "navigation@3"
        },
        {
          "command": "gitForge.compareReferences",
          "when": "view == gitForge.compare",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.compare.swap",
          "when": "view == gitForge.compare && gitForge.compare.active && gitForge.compare.hasRight",
          "group": "navigation@2"
        },
        {
          "command": "gitForge.compare.toggleMode",
          "when": "view == gitForge.compare && gitForge.compare.active",
          "group": "navigation@3"
        },
        {
          "command": "gitForge.compare.deploy",
          "when": "view == gitForge.compare && gitForge.compare.active && gitForge.deployAvailable",
          "group": "navigation@4"
        },
        {
          "command": "gitForge.compare.clear",
          "when": "view == gitForge.compare && gitForge.compare.active",
          "group": "navigation@5"
        },
        {
          "command": "gitForge.stash.push",
          "when": "view == gitForge.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.worktree.add",
          "when": "view == gitForge.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.graphView.refresh",
          "when": "view == gitForge.graphView",
          "group": "navigation@1"
        },
        {
          "command": "gitForge.showGraph",
          "when": "view == gitForge.graphView",
          "group": "navigation@2"
        },
        {
          "command": "gitForge.mergeLocal",
          "when": "view == gitForge.graphView && config.gitForge.merge.enabled",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "gitForge.history.openRevision",
          "when": "view == gitForge.history && viewItem =~ /^gitForge\\.commit/",
          "group": "1_open@1"
        },
        {
          "command": "gitForge.history.compareWithWorking",
          "when": "view == gitForge.history && viewItem == gitForge.commit",
          "group": "1_open@2"
        },
        {
          "command": "gitForge.history.copySha",
          "when": "view == gitForge.history && viewItem =~ /^gitForge\\.commit/",
          "group": "2_copy@1"
        },
        {
          "command": "gitForge.history.copyMessage",
          "when": "view == gitForge.history && viewItem =~ /^gitForge\\.commit/",
          "group": "2_copy@2"
        },
        {
          "command": "gitForge.conflicts.keepOurs",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "inline@1"
        },
        {
          "command": "gitForge.conflicts.keepTheirs",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "inline@2"
        },
        {
          "command": "gitForge.conflicts.keepBoth",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "inline@3"
        },
        {
          "command": "gitForge.conflicts.keepOurs",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "1_keep@1"
        },
        {
          "command": "gitForge.conflicts.keepTheirs",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "1_keep@2"
        },
        {
          "command": "gitForge.conflicts.keepBoth",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictBlock",
          "group": "1_keep@3"
        },
        {
          "command": "gitForge.conflicts.openMergeEditor",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictFile.text",
          "group": "inline@1"
        },
        {
          "command": "gitForge.conflicts.markResolved",
          "when": "view == gitForge.conflicts && viewItem =~ /^gitForge\\.conflictFile\\.(text|other)$/",
          "group": "inline@2"
        },
        {
          "command": "gitForge.conflicts.keepAllOurs",
          "when": "view == gitForge.conflicts && viewItem =~ /^gitForge\\.conflictFile\\.(text|other)$/",
          "group": "1_keep@1"
        },
        {
          "command": "gitForge.conflicts.keepAllTheirs",
          "when": "view == gitForge.conflicts && viewItem =~ /^gitForge\\.conflictFile\\.(text|other)$/",
          "group": "1_keep@2"
        },
        {
          "command": "gitForge.conflicts.openMergeEditor",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictFile.text",
          "group": "2_resolve@1"
        },
        {
          "command": "gitForge.conflicts.markResolved",
          "when": "view == gitForge.conflicts && viewItem =~ /^gitForge\\.conflictFile\\.(text|other)$/",
          "group": "2_resolve@2"
        },
        {
          "command": "gitForge.conflicts.keepFile",
          "when": "view == gitForge.conflicts && viewItem == gitForge.conflictFile.deleted",
          "group": "1_keep@1"
        },
        {
          "command": "gitForge.conflicts.deleteFile",
          "when": "view == gitForge.conflicts && viewItem =~ /^gitForge\\.conflictFile\\.(deleted|gone)$/",
          "group": "1_keep@2"
        },
        {
          "command": "gitForge.stash.apply",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "inline@1"
        },
        {
          "command": "gitForge.stash.pop",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "inline@2"
        },
        {
          "command": "gitForge.stash.drop",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "inline@3"
        },
        {
          "command": "gitForge.stash.apply",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitForge.stash.pop",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitForge.stash.drop",
          "when": "view == gitForge.stashes && viewItem == gitForge.stash",
          "group": "1_stash@3"
        },
        {
          "command": "gitForge.worktree.open",
          "when": "view == gitForge.worktrees && viewItem =~ /^gitForge\\.worktree/",
          "group": "inline@1"
        },
        {
          "command": "gitForge.worktree.remove",
          "when": "view == gitForge.worktrees && viewItem == gitForge.worktree",
          "group": "inline@2"
        },
        {
          "command": "gitForge.revert",
          "when": "view == gitForge.history && viewItem == gitForge.commit && config.gitForge.operations.enabled",
          "group": "3_operations@2"
        },
        {
          "command": "gitForge.reset",
          "when": "view == gitForge.history && viewItem == gitForge.commit && config.gitForge.operations.enabled",
          "group": "3_operations@3"
        },
        {
          "command": "gitForge.interactiveRebase",
          "when": "view == gitForge.history && viewItem == gitForge.commit && config.gitForge.operations.enabled",
          "group": "3_operations@4"
        }
      ],
      "editor/context": [
        {
          "command": "gitForge.showLineHistory",
          "when": "gitForge.active && config.gitForge.history.enabled && resourceScheme == file",
          "group": "gitForge@1"
        },
        {
          "command": "gitForge.showFileHistory",
          "when": "gitForge.active && config.gitForge.history.enabled && resourceScheme == file",
          "group": "gitForge@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitForge.showFileHistory",
          "when": "gitForge.active && config.gitForge.history.enabled && resourceScheme == file",
          "group": "gitForge@1"
        }
      ],
      "explorer/context": [
        {
          "command": "gitForge.showFileHistory",
          "when": "gitForge.active && config.gitForge.history.enabled && !explorerResourceIsFolder",
          "group": "gitForge@1"
        }
      ],
      "webview/context": [
        {
          "command": "gitForge.graph.checkoutCommit",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit'",
          "group": "1_checkout@1"
        },
        {
          "command": "gitForge.graph.createBranch",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit'",
          "group": "2_create@1"
        },
        {
          "command": "gitForge.graph.createTag",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit'",
          "group": "2_create@2"
        },
        {
          "command": "gitForge.graph.compareWithHead",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.compare.enabled",
          "group": "3_compare@1"
        },
        {
          "command": "gitForge.graph.compareWithSelected",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.compare.enabled",
          "group": "3_compare@2"
        },
        {
          "command": "gitForge.graph.copySha",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection =~ /^(commit|branch)$/",
          "group": "9_copy@1"
        },
        {
          "command": "gitForge.graph.checkoutBranch",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'branch'",
          "group": "1_checkout@1"
        },
        {
          "command": "gitForge.graph.mergeBranch",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'branch' && config.gitForge.merge.enabled",
          "group": "2_merge@1"
        },
        {
          "command": "gitForge.graph.deleteBranch",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'branch'",
          "group": "3_delete@1"
        },
        {
          "command": "gitForge.cherryPick",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.operations.enabled",
          "group": "4_operations@1"
        },
        {
          "command": "gitForge.revert",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.operations.enabled",
          "group": "4_operations@2"
        },
        {
          "command": "gitForge.reset",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.operations.enabled",
          "group": "4_operations@3"
        },
        {
          "command": "gitForge.interactiveRebase",
          "when": "webviewId =~ /^gitForge\\.graph(View)?$/ && webviewSection == 'commit' && config.gitForge.operations.enabled",
          "group": "4_operations@4"
        }
      ]
    },
    "colors": [
      {
        "id": "gitForge.blameForeground",
        "description": "%color.blameForeground%",
        "defaults": {
          "dark": "#ffffff59",
          "light": "#00000059",
          "highContrast": "#ffffff99",
          "highContrastLight": "#00000099"
        }
      }
    ],
    "views": {
      "gitForge": [
        {
          "type": "webview",
          "id": "gitForge.commitView",
          "name": "%view.commit%",
          "when": "gitForge.active && config.gitForge.commit.enabled"
        },
        {
          "id": "gitForge.conflicts",
          "name": "%view.conflicts%",
          "when": "gitForge.active && config.gitForge.conflicts.enabled && gitForge.conflicts.active",
          "visibility": "collapsed"
        },
        {
          "id": "gitForge.history",
          "name": "%view.history%",
          "when": "gitForge.active && config.gitForge.history.enabled",
          "visibility": "collapsed"
        },
        {
          "id": "gitForge.compare",
          "name": "%view.compare%",
          "when": "gitForge.active && config.gitForge.compare.enabled",
          "visibility": "collapsed"
        },
        {
          "id": "gitForge.stashes",
          "name": "%view.stashes%",
          "when": "gitForge.active && config.gitForge.compare.enabled",
          "visibility": "collapsed"
        },
        {
          "id": "gitForge.worktrees",
          "name": "%view.worktrees%",
          "when": "gitForge.active && config.gitForge.compare.enabled",
          "visibility": "collapsed"
        }
      ],
      "gitForgePanel": [
        {
          "type": "webview",
          "id": "gitForge.graphView",
          "name": "%view.graph%",
          "when": "gitForge.active && config.gitForge.graph.enabled"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gitForge.rebaseTodo",
        "displayName": "%customEditor.rebaseTodo%",
        "selector": [
          {
            "filenamePattern": "git-rebase-todo"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitForge",
          "title": "%viewsContainer.gitForge%",
          "icon": "media/spark.svg"
        }
      ],
      "panel": [
        {
          "id": "gitForgePanel",
          "title": "%viewsContainer.gitForge%",
          "icon": "media/spark.svg"
        }
      ]
    }
  }
}
