{
  "name": "git-forge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "preview": true,
  "publisher": "yuval-abdm",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2b24",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuval-Abdm/vscode-extensions.git",
    "directory": "packages/git-forge"
  },
  "bugs": {
    "url": "https://github.com/Yuval-Abdm/vscode-extensions/issues"
  },
  "homepage": "https://github.com/Yuval-Abdm/vscode-extensions/tree/main/packages/git-forge#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "l10n": "./l10n",
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "history",
    "annotations",
    "graph",
    "merge",
    "conflicts",
    "rebase",
    "gitlens alternative"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.91.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "configuration": {
      "title": "Git Forge",
      "properties": {
        "gitForge.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.blame.enabled%"
        },
        "gitForge.blame.format": {
          "type": "string",
          "default": "${author}, ${date} • ${message}",
          "markdownDescription": "%config.blame.format%"
        },
        "gitForge.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.blame.statusBar%"
        },
        "gitForge.blame.maxLines": {
          "type": "number",
          "default": 20000,
          "minimum": 1,
          "description": "%config.blame.maxLines%"
        }
      }
    },
    "commands": [
      {
        "command": "gitForge.toggleFileBlame",
        "title": "%command.toggleFileBlame%",
        "category": "Git Forge"
      },
      {
        "command": "gitForge.showLineCommit",
        "title": "%command.showLineCommit%",
        "category": "Git Forge"
      },
      {
        "command": "gitForge.diffWithPrevious",
        "title": "%command.diffWithPrevious%",
        "category": "Git Forge"
      },
      {
        "command": "gitForge.openRevision",
        "title": "%command.openRevision%",
        "category": "Git Forge"
      },
      {
        "command": "gitForge.copySha",
        "title": "%command.copySha%",
        "category": "Git Forge"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitForge.toggleFileBlame",
          "when": "gitForge.active && config.gitForge.blame.enabled"
        },
        {
          "command": "gitForge.showLineCommit",
          "when": "gitForge.active && config.gitForge.blame.enabled"
        },
        {
          "command": "gitForge.diffWithPrevious",
          "when": "false"
        },
        {
          "command": "gitForge.openRevision",
          "when": "false"
        },
        {
          "command": "gitForge.copySha",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "gitForge.blameForeground",
        "description": "%color.blameForeground%",
        "defaults": {
          "dark": "#ffffff59",
          "light": "#00000059",
          "highContrast": "#ffffff99",
          "highContrastLight": "#00000099"
        }
      }
    ]
  }
}
