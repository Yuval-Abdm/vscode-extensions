{
  "name": "php-forge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "preview": true,
  "publisher": "yuval-abdm",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b2140",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuval-Abdm/vscode-extensions.git",
    "directory": "packages/php-forge"
  },
  "bugs": {
    "url": "https://github.com/Yuval-Abdm/vscode-extensions/issues"
  },
  "homepage": "https://github.com/Yuval-Abdm/vscode-extensions/tree/main/packages/php-forge#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "php",
    "intellisense",
    "language server",
    "intelephense",
    "go to definition",
    "include",
    "legacy",
    "diagnostics"
  ],
  "main": "./dist/client.cjs",
  "activationEvents": [
    "onLanguage:php",
    "workspaceContains:**/*.php"
  ],
  "scripts": {
    "build": "node scripts/build-stubs.ts && node scripts/build.ts",
    "typecheck": "tsc -p .",
    "test": "node scripts/build.ts --dev && node --test \"test/**/*.test.ts\"",
    "bench": "node scripts/bench.ts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "minimatch": "^10.2.6",
    "tree-sitter-php": "0.24.2",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.91.0",
    "typescript": "^5.9.3",
    "vscode-jsonrpc": "9.0.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "phpForge.restartServer",
        "title": "%phpForge.restartServer.title%",
        "category": "PHP Forge"
      },
      {
        "command": "phpForge.reindex",
        "title": "%phpForge.reindex.title%",
        "category": "PHP Forge"
      },
      {
        "command": "phpForge.showOutput",
        "title": "%phpForge.showOutput.title%",
        "category": "PHP Forge"
      }
    ],
    "configuration": {
      "title": "PHP Forge",
      "properties": {
        "phpForge.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "markdownDescription": "%phpForge.exclude.description%"
        },
        "phpForge.maxFileSize": {
          "type": "number",
          "default": 2000000,
          "minimum": 10000,
          "markdownDescription": "%phpForge.maxFileSize.description%"
        },
        "phpForge.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%phpForge.trace.server.description%"
        }
      }
    }
  }
}
